    \usepackage{amsfonts}
    \usepackage{mathtools}
    \newcommand{\deriv}[2]{\frac{d#1}{d#2}}
    \newcommand{\R}{\mathbb{R}}v
    \newcommand{\Q}{\mathbb{Q}}
    \newcommand{\I}{\mathcal{I}}
    \newcommand{\J}{\mathcal{J}}
    \newcommand{\Sum}{\displaystyle\sum}
    \newcommand{\Int}{\displaystyle\int}
    \newcommand{\overint}{^U\displaystyle\int}
    \newcommand{\lowerint}{^L\displaystyle\int}
    \renewcommand{\Cup}{\displaystyle \bigcup}
    \renewcommand{\Cap}{\displaystyle \bigcap}
    \newcommand{\discont}{\operatorname{discont}}
\newcommand{\overbar}[1]{\overbracket{#1}}<!--Hack to get overline to not have a thickness that is invisible at normal zoom-->
\newcommand{\underbar}[1]{\underbracket{#1}}
    \newcommand{\Blank}[1]{
\begin{tabular}{c}\\\underline{\hspace{#1}}\end{tabular}
}
  </macros>
</docinfo>
